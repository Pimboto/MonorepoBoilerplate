# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Mode
# - development: Dev mode (pretty logs, verbose errors, hot reload)
# - production:  Prod mode (JSON logs, optimized, no introspection)
# - test:        Test mode (minimal logs, isolated DB)
# - staging:     Pre-prod environment (similar to prod but with more logging)
NODE_ENV=development

# Server Port
# Puerto donde correrá la API (default: 3001)
PORT=3001

# Service Name (opcional)
# Útil para identificar logs en sistemas con múltiples servicios
# SERVICE_NAME=api

# =============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# =============================================================================

# Connection Pooler URL (recomendado para serverless)
# Usar para conexiones desde tu app (con pooling)
DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# Direct Connection URL (opcional)
# Usar solo para migraciones o cuando necesites conexión directa
DIRECT_DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================

# Secret Key (base64)
# Genera uno con: openssl rand -base64 32
# ⚠️ NUNCA expongas esto en el código - solo en .env
BETTER_AUTH_SECRET="your-base64-encoded-secret-here"

# Base URL de la aplicación
# Usado para cookies y CORS (debe coincidir con tu dominio)
# - Local:      http://localhost:3001
# - Production: https://api.tudominio.com
BETTER_AUTH_URL="http://localhost:3001"

# =============================================================================
# GRAPHQL CONFIGURATION
# =============================================================================

# Habilitar Apollo Sandbox (el playground moderno)
# - true:  Sandbox habilitado (útil en dev/staging)
# - false: Deshabilitado (recomendado en producción)
GRAPHQL_PLAYGROUND_ENABLED=true

# Habilitar introspección del schema
# - true:  Permite queries de introspección (necesario para Sandbox/clients)
# - false: Deshabilitado (considerar en producción por seguridad)
GRAPHQL_INTROSPECTION_ENABLED=true

# =============================================================================
# LOGGER CONFIGURATION (Pino)
# =============================================================================

# Nivel de logs
# Valores (de menos a más verbose):
# - fatal:  Solo errores críticos que crashean la app
# - error:  Errores que requieren atención (500s, excepciones)
# - warn:   Advertencias (validaciones fallidas, deprecated features)
# - info:   Info general (requests completados, eventos importantes)
# - debug:  Info detallada de debugging (útil en desarrollo)
# - trace:  Nivel máximo de detalle (casi nunca necesario)
#
# Recomendaciones:
# - Development: debug (ver todo lo que pasa)
# - Staging:     info  (eventos importantes sin ruido)
# - Production:  warn  (solo problemas y errores)
LOG_LEVEL=debug

# Formateo de logs (solo aplica si NODE_ENV !== 'production')
# - true:  Logs bonitos con colores y timestamps legibles (desarrollo)
# - false: JSON crudo (útil si usas un log viewer local)
#
# Nota: En producción SIEMPRE se usa JSON sin importar este valor
# ⚠️ Esta variable YA NO SE USA - se determina por NODE_ENV automáticamente
LOG_PRETTY=true

# =============================================================================
# TIPS & BEST PRACTICES
# =============================================================================
#
# 1. NUNCA commitees el archivo .env real - solo .env.example
# 2. Usa diferentes .env para cada ambiente (local, staging, prod)
# 3. En producción:
#    - NODE_ENV=production
#    - LOG_LEVEL=warn o info
#    - GRAPHQL_INTROSPECTION_ENABLED=false (opcional, por seguridad)
# 4. Genera secretos fuertes:
#    - BETTER_AUTH_SECRET: openssl rand -base64 32
# 5. Usa variables de entorno del hosting para secretos en prod
#    (Vercel, Railway, AWS, etc. - nunca hardcodees secretos)
#
# =============================================================================

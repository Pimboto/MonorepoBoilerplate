{
  "name": "api",
  "version": "0.0.1",
  "description": "Clean Architecture NestJS API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "cd ../../packages/database && pnpm prisma:generate",
    "prisma:migrate": "cd ../../packages/database && pnpm prisma:migrate",
    "prisma:migrate:prod": "cd ../../packages/database && pnpm prisma:migrate:prod",
    "prisma:studio": "cd ../../packages/database && pnpm prisma:studio",
    "prisma:seed": "cd ../../packages/database && pnpm prisma:seed",
    "prisma:reset": "cd ../../packages/database && pnpm prisma:reset",
    "prebuild": "cd ../../packages/database && pnpm prisma:generate && cd ../../apps/api && rimraf dist",
    "build": "nest build",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "clean": "rimraf dist .turbo node_modules"
  },
  "dependencies": {
    "@apollo/server": "^5.3.0",
    "@as-integrations/express5": "^1.1.2",
    "@cocostudio/database": "workspace:*",
    "@cocostudio/shared": "workspace:*",
    "@nestjs/apollo": "^13.2.3",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/graphql": "^13.2.3",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/platform-express": "^11.1.12",
    "better-auth": "^1.4.18",
    "body-parser": "^2.2.2",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "nestjs-pino": "^4.5.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.7",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
